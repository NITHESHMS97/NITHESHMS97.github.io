---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostTree from '../../components/PostTree.astro';
import { getPosts, buildTree, flatten, readingTime, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tree = buildTree(posts);
  const order = flatten(tree);
  return posts.map((post) => {
    const i = order.findIndex((p) => p.id === post.id);
    return { params: { slug: post.id }, props: { post, tree, prev: order[i - 1], next: order[i + 1] } };
  });
}

const base = import.meta.env.BASE_URL;
const { post, tree, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const date = post.data.date;
const file = post.filePath ?? `src/content/posts/${post.id}.md`;
---
<Base title={post.data.title} description={post.data.description}>
  <div class="post-layout">
    <aside class="side-tree">
      <details class="panel" open>
        <summary class="section-title">Posts</summary>
        <PostTree nodes={tree} currentId={post.id} />
      </details>
    </aside>
    <article class="post">
      <header class="post-head">
        <h1>{post.data.title}</h1>
        <p class="meta">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          <span class="pill">{readingTime(post.body)} min read</span>
          {import.meta.env.DEV && <a class="edit-link" href={`${base}editor/?path=${encodeURIComponent(file)}`}>Edit</a>}
        </p>
      </header>
      <div class="prose"><Content /></div>
      <nav class="pager" aria-label="Previous and next post">
        {prev ? <a href={`${base}posts/${prev.id}/`}><small>← Previous</small>{prev.data.title}</a> : <span />}
        {next ? <a class="next" href={`${base}posts/${next.id}/`}><small>Next →</small>{next.data.title}</a> : <span />}
      </nav>
    </article>
    {toc.length > 1 && (
      <nav class="toc" aria-label="Table of contents">
        <p class="section-title">On this page</p>
        <ol>
          {toc.map((h) => <li class={`h${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
    )}
  </div>
</Base>
