---
import Base from '../layouts/Base.astro';
import PostTree from '../components/PostTree.astro';
import { getPosts, buildTree, readingTime, formatDate } from '../lib/posts';

const base = import.meta.env.BASE_URL;
const posts = (await getPosts()).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const tree = buildTree(posts);
---
<Base title="System Design Notes">
  <section class="hero">
    <p class="eyebrow">Engineering notes</p>
    <h1>System design, <span>explained step by step.</span></h1>
    <p class="intro">Short, practical write-ups on designing systems that scale. Follow a topic from start to finish using the tree.</p>
  </section>
  <div class="home-grid">
    <section aria-labelledby="latest">
      <h2 id="latest" class="section-title">Latest posts</h2>
      <ul class="cards">
        {posts.map((p) => (
          <li class="card">
            <a href={`${base}posts/${p.id}/`}>
              <span class="meta">
                <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                <span class="pill">{readingTime(p.body)} min read</span>
              </span>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
              <span class="more">Read post →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <aside class="panel" aria-labelledby="topics">
      <h2 id="topics" class="section-title">Browse by topic</h2>
      <PostTree nodes={tree} openAll />
    </aside>
  </div>
</Base>
